# `brew bundle check` and `brew bundle cleanup` (dry-run; never --force blindly).

# --- Shell spine -------------------------------------------------------------
# The prompt, completion and navigation layer that makes zsh worth living in.
brew "starship"                 # prompt
brew "zsh-autosuggestions"      # history-driven inline suggestions
brew "zsh-completions"          # extra completion definitions
brew "zsh-syntax-highlighting"  # as-you-type validity colouring
brew "fzf"                      # fuzzy selection; also backs fzf-tab
brew "zoxide"                   # frecency-ranked cd

# --- Modern CLI replacements -------------------------------------------------
# Drop-in successors to the BSD/GNU defaults, aliased in the shell config.
brew "bat"                      # cat
brew "eza"                      # ls
brew "fd"                       # find
brew "ripgrep"                  # grep

# --- Git & repo hygiene ------------------------------------------------------
brew "gh"                       # GitHub CLI; also the git credential helper
brew "gitleaks"                 # secret scanning; pre-commit hook for this repo
brew "lefthook"                 # hook manager, used by work repos and here

# --- Language toolchains -----------------------------------------------------
brew "node"                     # required by tooling, not a chosen dev stack
brew "go"                       # kept for now, pending review
brew "cmake"                    # kept for now, pending review
brew "ninja"                    # kept for now, pending review

# --- Network & security ------------------------------------------------------
brew "nmap"                     # network swiss-army knife
brew "cloudflared"              # kept for now, pending review

# --- Device tooling ----------------------------------------------------------
cask "android-platform-tools"   # adb / fastboot

# --- Node package manager ----------------------------------------------------
# Slated for removal once pnpm is provisioned via corepack instead.
npm "pnpm"

# --- Mac App Store -----------------------------------------------------------
