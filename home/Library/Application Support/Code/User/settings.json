{
    // Deviations from stock VS Code only. A default that moves is pinned
    // back here the day it moves, not in advance.

    // ── Workbench ────────────────────────────────────────────────
    "workbench.startupEditor": "none",

    // ── Editor ───────────────────────────────────────────────────
    "editor.fontFamily": "Fira Code",
    "editor.fontLigatures": true,
    "editor.minimap.enabled": false,
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.formatOnSave": true,

    // ── Files ────────────────────────────────────────────────────
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    // ── Terminal ─────────────────────────────────────────────────
    // Nerd Font so starship and eza glyphs render. Ghostty uses the same face.
    "terminal.integrated.fontFamily": "FiraCode Nerd Font",
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.scrollback": 10000,

    // ── Git ──────────────────────────────────────────────────────
    "git.autofetch": true,

    // ── Python ───────────────────────────────────────────────────
    // ty is the language server (its extension sets python.languageServer
    // to None). Ruff formats. ty is beta; watch the Stable milestone:
    // github.com/astral-sh/ty/milestone/4
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },

    // ── Privacy ──────────────────────────────────────────────────
    "telemetry.telemetryLevel": "off",
    "chat.disableAIFeatures": true
}
