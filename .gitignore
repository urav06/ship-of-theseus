# Deny by default. Nothing enters this repo unless explicitly re-included below.
# Note: git can't re-include a file whose parent directory is excluded, so every
# directory level must be re-included before the files inside it.
/**

# Repo root
!/.gitignore
!/LICENSE
!/README.md
!/.claude/
!/.claude/settings.json
!/.vscode/
!/.vscode/settings.json
!/lefthook.yml

# home/ — mirror of ~ (home/.config is live: ~/.config symlinks to it)
!/home/
!/home/.zshenv
!/home/.config/

# system/ — mirror of / for root-owned files (applied with sudo cp)
!/system/
!/system/etc/
!/system/etc/pam.d/
!/system/etc/pam.d/sudo_local

# claude code (copy lane: the rest of ~/.claude is session state)
!/home/.claude/
!/home/.claude/CLAUDE.md
!/home/.claude/settings.json
!/home/.claude/statusline.sh

# zsh
!/home/.config/zsh/
!/home/.config/zsh/.zshenv
!/home/.config/zsh/.zprofile
!/home/.config/zsh/.zshrc

# git
!/home/.config/git/
!/home/.config/git/config
!/home/.config/git/ignore

# gh (hosts.yml stays excluded, see bottom)
!/home/.config/gh/
!/home/.config/gh/config.yml

# zed
!/home/.config/zed/
!/home/.config/zed/settings.json

# vscode (copy lane: ~/Library/Application Support/Code/User/settings.json)
!/home/Library/
!/home/Library/Application Support/
!/home/Library/Application Support/Code/
!/home/Library/Application Support/Code/User/
!/home/Library/Application Support/Code/User/settings.json

# homebrew
!/home/.config/homebrew/
!/home/.config/homebrew/Brewfile

# ghostty
!/home/.config/ghostty/
!/home/.config/ghostty/config

# starship (empty file = all defaults, tracked deliberately)
!/home/.config/starship.toml

# ripgrep
!/home/.config/ripgrep/
!/home/.config/ripgrep/config


# never track (secret fallback path — gh writes oauth_token here if Keychain is unavailable)
/home/.config/gh/hosts.yml
